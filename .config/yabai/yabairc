sudo yabai --load-sa

# source the colours file

# Setting bsp (binary space partitioning) as base layout config
yabai -m config layout bsp

# Stack of float
yabai -m config window_placement second_child

# Padding
yabai -m config top_padding 15
yabai -m config bottom_padding 15
yabai -m config left_padding 15
yabai -m config right_padding 15
yabai -m config window_gap 15

# Mouse follows focus
yabai -m config mouse_follows_focus on

# Mouse
yabai -m config mouse_modifier alt
# LMB + drag
yabai -m config mouse_action1 move
# RMB + drag
yabai -m config mouse_action2 resize

# Apps excluded from yabai
yabai -m rule --add app="^System Settings$" manage=off # Settings refuse to be resized
yabai -m rule --add app="^Proton VPN$" manage=off
yabai -m rule --add app="^Steam$" manage=off # Steam is behaving a bit buggy
yabai -m rule --add app="^FL Studio 2025$" manage=off 

# External bar padding
yabai -m config external_bar all:33:0

# Debug reporting
yabai -m config debug_output true

# Bootstrap janky borders
borders active_color=0xff94dcff inactive_color=0xa1000000 inactive_width=5.0 width = 5.0 blacklist="iPhone Mirroring" & 

