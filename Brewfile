# Homebrew dependencies for the dotfiles (macOS).
# Install with: brew bundle --file=Brewfile

# Taps
tap "felixkratz/formulae" # JankyBorders

# Window management / menu bar (macOS)
brew "yabai"
brew "skhd"
brew "sketchybar"
brew "felixkratz/formulae/borders"
cask "hyperkey"
cask "wallpaper"

# Terminal / shell
cask "kitty"
brew "neovim"
cask "oh-my-zsh"
brew "starship"
brew "zsh-syntax-highlighting"
brew "zsh-autosuggestions"
brew "zsh-vi-mode"
brew "nvm"

# CLI tools
brew "eza"
brew "fzf"
brew "ripgrep"
brew "zoxide"
brew "lazygit"
brew "fastfetch"
brew "superfile"
brew "termdown"
brew "gh"
brew "opencode"

# Spotify theming
cask "spotify"
tap "spicetify/homebrew-tap"
brew "spicetify/homebrew-tap/spicetify"

# Manual installs (no brew formula):
# - herdr:            see https://github.com/steipete/herdr
# - sketchybar_lua:   git clone https://github.com/FelixKratz/SbarLua && cd SbarLua && make install INIT_LUA=false
#                     (installs to ~/.local/share/sketchybar_lua)
# - stats_provider:   build from https://github.com/loosrig/system-stats
#                     (Apple Silicon vs Intel binaries differ; install to ~/.local/bin/stats_provider)
