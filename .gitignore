# gitignore file for the dotfiles config

# macOS system files
.DS_Store

# vim tempfiles
*.swp
*.swo
*~

# Unnecessary superfile files
**/lastCheckedVersion
**/lastdir
**/toggleDotFile
**/toggleFooter
**/themeFileVersion
**/firstUseCheck
**/pinned.json

# Compiled binaries from sketchybar
sketchybar/.config/sketchybar/helpers*

# Logs
*.log

# Backup files
*.bak
*.backup

# Any SSH keys
.ssh/
